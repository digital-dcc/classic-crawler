---
import { app } from "../firebase/server";
import { getAuth } from "firebase-admin/auth";
import Layout from "../layouts/Layout.astro";
import { HeaderBar } from "../components/header-bar";

/* Check if the user is authenticated */
let decodedCookie;
const auth = getAuth(app);
if (Astro.cookies.has("__session")) {
  try {
    const sessionCookie = Astro.cookies.get("__session").value;
    decodedCookie = await auth.verifySessionCookie(sessionCookie);
  } catch (error) {
    // noop, if the cookie is invalid, the user is not authenticated yet
  }
}
---

<Layout title="Classic Crawler - DCC Character Creation Tools">
	<section class="navigation-bar">
		<HeaderBar />
	</section>
	<main>
		<section class="top-container">
			<div class="hero-container">
				<div class="hero-content">
					<h1 class="hero-title">Dungeon Crawl Classics</h1>
					<h2 class="hero-subtitle">Digital Character Tools</h2>
					<p>Digital character builder for the Dungeon Crawl Classics tabletop role playing game.</p>
					<p>Build, manage and run your DCC characters right from your browser.</p>
					<a class="get-started-button" href={decodedCookie ? '/characters' : '/signin'}>Get Started</a>
				</div>
			</div>
		</section>
		<section class="main-container">
			<ul>
				<li>Easily build characters</li>
				<li>Manage and run characters at the table</li>
				<li>Grouped characters for funnel play</li>
			</ul>
		</section>
	</main>
</Layout>

<style>
	* {
		box-sizing: border-box;
	}
	h1, h2 {
		margin: 0;
		padding: 0;
		font-size: 2.5rem;
	}
	h2 {
		font-size: 1.5rem;
	}
	.top-container {
		background-image: url('/images/hellscape.png');
		background-size: cover;
		background-position: center;
		background-repeat: no-repeat;
	}
	.hero-container {
		font-size: 1rem;
		max-width: 1140px;
		margin: 0 auto;
		padding: 2.5em 1em;
	}
	.hero-content {
		background: rgb(0,0,0,0.4);
		padding: 2.5em;
		color: white;
		border-radius: 5px;
		width: 50%;
	}
	@media (max-width: 600px) {
		.hero-content {
			width: unset;
		}
	}
	.hero-content h1, p {}
	.main-container {
		max-width: 1140px;
		margin: 0 auto;
		padding: 1em;
	}
	.get-started-button {
		display: inline-block;
		background-color: #4CAF50;
		border-radius: 5px;
		color: white;
		padding: 1em 1em;
		text-decoration: none;
		width: 100%;
		text-align: center;
	}
</style>
